    {
      "id": "e_mtgy505r0eor4g",
      "name": "Informace o šabloně",
      "typeId": "t_mtgxt0qhthmi19",
      "inInbox": true,
      "aspects": [],
      "attributes": {
        "a_mtgxtmum68o180": true,
        "a_mtgxu9x0k13qu1": false
      },
      "customAttributes": [
        {
          "id": "ca_mtgy505rhf64gi",
          "name": "Atributy",
          "type": "textarea",
          "value": "Tohle je rozpracovaná DKM a EDM šablona pro datový fond, konceptuální datový model a datovou architekturu v ISVS.\n\nŠablona je v souladu s požadavky zákona č. 365/2000 a zákona č. 60/2026. Její povinné součásti jsou neměnné, nicméné vždycky si můžete dotvořit vlastní typy entit, aspekty, atributy, cokoliv."
        }
      ],
      "relations": [],
      "createdAt": "2026-08-31T07:58:17.103Z",
      "updatedAt": "2026-08-31T08:01:15.063Z",
      "comments": [
        {
          "id": "c_mtgy8th32533vb",
          "content": "Tohle je about. Můžete ho klidně smazat, pokud ho nepotřebujete.",
          "author": "Michal Rada",
          "createdAt": "2026-08-31T08:01:15.063Z"
        }
      ]
    },
