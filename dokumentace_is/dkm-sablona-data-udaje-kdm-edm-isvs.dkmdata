    {
      "id": "e_mp2dqrea4ysj6t",
      "name": "Referenční údaj právnické osoby Název osoby",
      "typeId": "t_moq2i7h6z3qdnc",
      "inInbox": false,
      "aspects": [
        "asp_mp2ddlpsra55nf"
      ],
      "attributes": {
        "a_moq2is6xmsgbhd": "Obchodní firma nebo název nebo označení právnické osoby; jméno, popřípadě jména, a příjmení fyzické osoby v případech, kdy fyzická osoba nemá přidělené identifikační číslo osoby a údaje o ní se vedou v registru osob na základě jiného právního předpisu (§ 25 písm. e) zákona č. 111/2009 Sb.). Vedeno v základním registru osob jako referenční údaj.",
        "a_moq2j3rot8ekzo": true,
        "a_mp2df9rc7h5352": "§ 26 odst. 2 písm. a) a písm. c)",
        "a_mp2de93ulmpfc0": "e_mtgyocn1for4zn"
      },
